<Layouts.app flash={@flash} current_scope={@current_scope} full_screen navbar={false}>
  <%= if @error do %>
    <div class="mx-auto mt-16 max-w-md rounded-2xl bg-base-200 p-8 text-center shadow">
      <p class="text-lg font-semibold text-error">{@error}</p>
      <.link
        navigate={~p"/lobby"}
        class="mt-5 inline-flex min-h-[2.75rem] items-center rounded-full bg-amber-400 px-5 text-sm font-semibold text-amber-950 shadow transition hover:bg-amber-300"
      >
        Back to Lobby
      </.link>
    </div>
  <% else %>
    <div id="game-page" class="flex min-h-0 flex-1 flex-col">
      <%!-- The table: wooden rim around a green felt surface --%>
      <section
        id="card-table"
        class="table-rim flex min-h-0 flex-1 flex-col rounded-[1.75rem] sm:rounded-[3rem] p-1.5 sm:p-3"
      >
        <div class="table-felt relative flex min-h-0 flex-1 flex-col overflow-hidden rounded-[1.4rem] sm:rounded-[2.4rem] px-2 pt-2 pb-3 sm:px-8 sm:pt-4 sm:pb-5 lg:px-12 text-white">
          <%!-- Game info, discreetly in the table's top corners --%>
          <div
            id="table-info"
            class="flex shrink-0 items-start justify-between gap-2 text-white/75"
          >
            <div class="flex items-center gap-2">
              <.link
                navigate={~p"/lobby"}
                aria-label="Back to lobby"
                class="grid size-8 place-items-center rounded-full bg-black/20 ring-1 ring-white/10 transition hover:bg-black/35 hover:text-white"
              >
                <.icon name="hero-arrow-left" class="size-4" />
              </.link>
              <div class="leading-tight">
                <h1 class="text-xs sm:text-sm font-semibold text-white/90">Game {@game_id}</h1>
                <p class="text-[0.7rem] sm:text-xs">
                  <%= case @game.status do %>
                    <% :waiting -> %>
                      Waiting for players
                    <% :playing -> %>
                      Round {@game.round}
                    <% :finished -> %>
                      Game Over
                  <% end %>
                </p>
              </div>
            </div>

            <div id="scoreboard" class="flex items-center gap-1.5" aria-label="Scores">
              <%= for team_id <- [:a, :b] do %>
                <div
                  id={"team-#{team_id}-score"}
                  class={[
                    "flex items-baseline gap-1.5 whitespace-nowrap rounded-full px-2.5 py-1 ring-1",
                    if(team_id == own_team(@current_player),
                      do: "bg-amber-300/15 ring-amber-300/40 text-amber-100",
                      else: "bg-black/20 ring-white/10"
                    )
                  ]}
                >
                  <span class="text-[0.65rem] font-semibold uppercase tracking-wider opacity-80">
                    Team {String.upcase(to_string(team_id))}
                  </span>
                  <span class="text-sm font-bold tabular-nums leading-none text-white">
                    {Map.fetch!(@game.teams, team_id).score}
                  </span>
                </div>
              <% end %>
            </div>
          </div>

          <%= if @game.status == :waiting do %>
            <div
              id="waiting-room"
              class="flex flex-1 flex-col items-center justify-center gap-5 py-6 text-center"
            >
              <div class="flex pl-8" aria-hidden="true">
                <%= for rotation <- ["-rotate-12", "-rotate-3", "rotate-6", "rotate-12"] do %>
                  <.card_back class={["-ml-8 shadow-lg", rotation]} />
                <% end %>
              </div>
              <div class="space-y-1">
                <p class="text-xl font-semibold">Waiting for players</p>
                <p class="text-sm text-white/75">
                  {length(@game.players)} / {@game.player_count} players joined
                </p>
              </div>

              <div class="flex flex-wrap justify-center gap-2">
                <%= for player <- Enum.sort_by(@game.players, & &1.seat) do %>
                  <.seat_badge
                    seat={player.seat}
                    team={player.team}
                    you={@current_player != nil and @current_player.id == player.id}
                  />
                <% end %>
              </div>

              <%= if @current_player do %>
                <div class="max-w-sm space-y-1 text-xs text-white/60">
                  <p>You are seated at position {@current_player.seat + 1}.</p>
                  <p id="waiting-hint">
                    Share the code <span class="font-mono font-semibold text-white">{@game_id}</span>.
                    The match starts automatically when every seat is filled. Each player
                    needs their own browser (a private window works for testing).
                  </p>
                </div>
              <% else %>
                <p class="rounded-full bg-rose-500/90 px-3 py-1 text-sm font-semibold">
                  This game is full.
                </p>
              <% end %>
            </div>
          <% else %>
            <%!--
              Phones: two columns, side seats share a row above the piles.
              Larger screens: side seats flank the piles in their own columns.
            --%>
            <div
              id="table-surface"
              class="grid min-h-0 flex-1 grid-cols-2 sm:grid-cols-[auto_minmax(0,1fr)_auto] content-between items-center gap-x-2 gap-y-3 sm:gap-x-6 overflow-y-auto overscroll-contain felt-scroll py-1"
            >
              <%!-- Top seat: partner (4 players) or opponent (2 players) --%>
              <div class="col-span-2 sm:col-span-1 sm:col-start-2 flex justify-center">
                <%= if @seats[:top] do %>
                  <.table_seat
                    player={@seats[:top]}
                    position={:top}
                    current_turn={@seats[:top].id == @turn_player_id}
                  />
                <% end %>
              </div>

              <div class="col-span-2 sm:col-span-1 sm:col-start-2">
                <.game_melds
                  id="opponent-melds"
                  label={if(@current_player, do: "Opponents", else: "Team")}
                  team_id={opponent_team(@current_player)}
                  team={Map.fetch!(@game.teams, opponent_team(@current_player))}
                />
              </div>

              <%!-- Side seats (4 players) --%>
              <%= if @seats[:left] do %>
                <div class="col-start-1 row-start-3 flex justify-start sm:justify-center">
                  <.table_seat
                    player={@seats[:left]}
                    position={:left}
                    current_turn={@seats[:left].id == @turn_player_id}
                  />
                </div>
              <% end %>

              <%!-- Centre: piles and a one-line status --%>
              <div class="col-span-2 row-start-4 sm:col-span-1 sm:col-start-2 sm:row-start-3 flex flex-col items-center gap-3 py-1">
                <.game_table
                  deck_count={length(@game.deck)}
                  discard_top={List.first(@game.discard_pile)}
                  discard_count={length(@game.discard_pile)}
                  morto_count={length(@game.morto)}
                  morto_taken_by={@game.morto_taken_by}
                  on_draw_deck="draw_deck"
                  on_draw_discard="draw_discard"
                  discard_disabled={not @can_draw or @discard_blocked}
                />

                <div class="flex min-h-7 flex-col items-center gap-1.5 text-center">
                  <%= if @turn_status do %>
                    <p
                      id="turn-status"
                      class={[
                        "rounded-full px-3 py-1 text-xs sm:text-sm font-medium",
                        if(@my_turn,
                          do: "bg-amber-300 text-amber-950 shadow",
                          else: "bg-black/25 text-white/85"
                        )
                      ]}
                    >
                      {@turn_status}
                    </p>
                  <% end %>

                  <%= if @discard_blocked do %>
                    <p
                      id="black-three-block"
                      class="rounded-full bg-black/40 px-3 py-1 text-xs text-white ring-1 ring-white/20"
                    >
                      The discard pile is blocked by a black three. Draw from the deck instead.
                    </p>
                  <% end %>

                  <%= if @message do %>
                    <p
                      id="table-message"
                      role="alert"
                      class="max-w-md rounded-full bg-rose-500 px-3 py-1 text-xs sm:text-sm font-medium text-white shadow motion-safe:animate-overlay-in"
                    >
                      {@message}
                    </p>
                  <% end %>
                </div>
              </div>

              <%= if @seats[:right] do %>
                <div class="col-start-2 row-start-3 sm:col-start-3 flex justify-end sm:justify-center">
                  <.table_seat
                    player={@seats[:right]}
                    position={:right}
                    current_turn={@seats[:right].id == @turn_player_id}
                  />
                </div>
              <% end %>

              <div class="col-span-2 row-start-5 sm:col-span-1 sm:col-start-2 sm:row-start-4">
                <.game_melds
                  id="own-melds"
                  label={if(@current_player, do: "Your team", else: "Team")}
                  team_id={own_team(@current_player)}
                  team={Map.fetch!(@game.teams, own_team(@current_player))}
                  on_add_to_meld={
                    if(length(@selected_card_ids) == 1 && @can_act, do: "add_to_meld")
                  }
                  on_replace_joker={
                    if(length(@selected_card_ids) == 1 && @can_act, do: "replace_joker")
                  }
                  selected_card_id={List.first(@selected_card_ids)}
                />
              </div>
            </div>

            <%!-- Bottom edge: your seat, hand and actions --%>
            <section
              id="your-seat"
              class="mt-2 shrink-0 border-t border-white/10 pt-2 sm:mt-3 sm:pt-3"
            >
              <%= if @current_player do %>
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <.seat_badge
                    seat={@current_player.seat}
                    team={@current_player.team}
                    current_turn={@current_player.id == @turn_player_id}
                    you
                  />
                  <span class="text-xs text-white/70 tabular-nums">
                    {length(@current_player.hand)} cards
                  </span>
                </div>

                <.game_hand
                  cards={@current_player.hand}
                  selected_ids={@selected_card_ids}
                  on_select="select_card"
                  disabled={@game.status == :finished}
                />

                <div
                  id="table-actions"
                  class="mt-3 flex flex-wrap items-center justify-center gap-2"
                >
                  <.table_button
                    id="meld-selected"
                    phx-click="meld_selected"
                    variant={:primary}
                    disabled={length(@selected_card_ids) < 3 or not @can_act}
                  >
                    Meld Selected
                  </.table_button>

                  <%= if selected_red_three?(@current_player, @selected_card_ids) do %>
                    <.table_button
                      id="place-red-three"
                      phx-click="place_red_three"
                      variant={:danger}
                      disabled={not @can_act}
                    >
                      Place Red 3
                    </.table_button>
                  <% end %>

                  <.table_button
                    id="discard-selected"
                    phx-click="discard_selected"
                    variant={:light}
                    disabled={length(@selected_card_ids) != 1 or not @can_act}
                  >
                    Discard
                  </.table_button>

                  <%= if not @show_round_end and @game.status == :playing do %>
                    <.table_button id="score-round" phx-click="score_round" variant={:ghost}>
                      Score Round
                    </.table_button>
                  <% end %>
                </div>
              <% else %>
                <div class="flex flex-col items-center gap-2">
                  <%= if @seats[:bottom] do %>
                    <.table_seat
                      player={@seats[:bottom]}
                      position={:bottom}
                      current_turn={@seats[:bottom].id == @turn_player_id}
                    />
                  <% end %>
                  <p class="text-center text-sm text-white/80">
                    You are not seated at this table.
                  </p>
                </div>
              <% end %>
            </section>
          <% end %>

          <%!-- Round end: scored hand breakdown over the table --%>
          <%= if @show_round_end do %>
            <div class="absolute inset-0 z-20 grid place-items-center overflow-y-auto bg-black/55 p-3 backdrop-blur-[2px]">
              <div
                id="round-end"
                class="w-full max-w-lg space-y-5 rounded-2xl bg-base-100 p-5 sm:p-6 text-base-content shadow-2xl motion-safe:animate-overlay-in"
              >
                <h2 class="text-center text-xl sm:text-2xl font-bold">
                  Round {@game.round} Complete
                </h2>

                <div class="grid gap-3 sm:grid-cols-2">
                  <%= for {team_id, breakdown} <- @round_breakdown do %>
                    <div class="space-y-2 rounded-xl bg-base-200 p-4">
                      <h3 class="font-semibold">Team {String.upcase(to_string(team_id))}</h3>
                      <ul class="space-y-1 text-sm">
                        <li class="flex justify-between">
                          <span>Meld points</span>
                          <span class="tabular-nums">{breakdown.meld_points}</span>
                        </li>
                        <li class="flex justify-between">
                          <span>Canastra bonus</span>
                          <span class="tabular-nums">+{breakdown.canastra_bonus}</span>
                        </li>
                        <li class="flex justify-between">
                          <span>Red three bonus</span>
                          <span class="tabular-nums">+{breakdown.red_three_bonus}</span>
                        </li>
                        <li class="flex justify-between text-error">
                          <span>Black three penalty</span>
                          <span class="tabular-nums">{breakdown.black_three_penalty}</span>
                        </li>
                        <li class="flex justify-between border-t border-base-300 pt-1 font-bold">
                          <span>Round total</span>
                          <span class="tabular-nums">{breakdown.round_total}</span>
                        </li>
                      </ul>
                    </div>
                  <% end %>
                </div>

                <div class="text-center">
                  <.table_button
                    id="continue-round"
                    phx-click="continue_round"
                    variant={:primary}
                    class="w-full sm:w-auto px-8"
                  >
                    Continue
                  </.table_button>
                </div>
              </div>
            </div>
          <% end %>

          <%!-- Game over: final scores and round history over the table --%>
          <%= if @game.status == :finished do %>
            <div class="absolute inset-0 z-30 grid place-items-center overflow-y-auto bg-black/55 p-3 backdrop-blur-[2px]">
              <div
                id="game-over"
                class="w-full max-w-lg space-y-5 rounded-2xl bg-base-100 p-5 sm:p-6 text-center text-base-content shadow-2xl motion-safe:animate-overlay-in"
              >
                <p class="text-2xl sm:text-3xl font-bold text-success">
                  Team {String.upcase(to_string(@game.winner))} wins!
                </p>

                <div class="grid grid-cols-2 gap-3">
                  <%= for team_id <- [:a, :b] do %>
                    <div class={[
                      "rounded-xl p-4",
                      if(team_id == @game.winner,
                        do: "bg-success/15 ring-1 ring-success/40",
                        else: "bg-base-200"
                      )
                    ]}>
                      <p class="text-sm opacity-75">Team {String.upcase(to_string(team_id))}</p>
                      <p class="text-3xl font-bold tabular-nums">
                        {Map.fetch!(@game.teams, team_id).score}
                      </p>
                    </div>
                  <% end %>
                </div>

                <%= if @rounds != [] do %>
                  <div class="space-y-2 text-left">
                    <h3 class="text-center font-semibold">Round History</h3>
                    <ul class="max-h-48 space-y-1.5 overflow-y-auto">
                      <%= for round <- @rounds do %>
                        <li class="flex items-center justify-between rounded-lg bg-base-200 px-3 py-2 text-sm">
                          <span class="font-semibold">Round {round.round_number}</span>
                          <span class="tabular-nums">
                            A {round.team_a_score} · B {round.team_b_score}
                            <%= if round.winner do %>
                              · Winner {String.upcase(round.winner)}
                            <% end %>
                          </span>
                        </li>
                      <% end %>
                    </ul>
                  </div>
                <% end %>

                <div class="flex flex-col sm:flex-row justify-center gap-2">
                  <.table_button id="rematch" phx-click="rematch" variant={:primary}>
                    Rematch
                  </.table_button>
                  <.link
                    navigate={~p"/lobby"}
                    class="inline-flex min-h-[2.75rem] items-center justify-center rounded-full bg-base-200 px-4 text-sm font-semibold transition hover:bg-base-300"
                  >
                    Back to Lobby
                  </.link>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    </div>
  <% end %>
</Layouts.app>
